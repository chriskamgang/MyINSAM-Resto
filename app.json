{
  "expo": {
    "name": "Estuaire Eat",
    "slug": "myinsam-resto",
    "scheme": "com.chrisdev237.myinsamresto1",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "description": "Commandez vos plats préférés et faites-vous livrer rapidement à Bafoussam. Livraison rapide, paiement sécurisé.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "privacyPolicyUrl": "https://votresite.com/privacy",
      "termsOfServiceUrl": "https://votresite.com/terms",
      "supportEmail": "support@myinsam.cm",
      "supportPhone": "+237659339778",
      "eas": {
        "projectId": "a1d20e41-dc5c-4bec-bff2-f90d8aee4226"
      }
    },
    "owner": "chrisdev237",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chrisdev237.estuaireresto",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "11",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "L'application utilise votre position pour définir votre adresse de livraison.",
        "NSLocationAlwaysUsageDescription": "L'application utilise votre position pour définir votre adresse de livraison."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.chrisdev237.myinsamresto1",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
